# ===========================================
# Paris Flat Hunter — environment variables
# ===========================================
# Copy this file to `.env` and fill in the secrets.
# Never commit `.env` to git. chmod 600 .env on the VPS.

# ---- App ----
APP_ENV=dev                  # dev | prod
LOG_LEVEL=INFO
TZ=Europe/Paris

# ---- Postgres ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pfh
POSTGRES_USER=pfh
POSTGRES_PASSWORD=change-me-please
# Full DSN override (leave empty to compose from parts above)
DATABASE_URL=

# ---- Anthropic (Claude) ----
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6
# Hard monthly cap in EUR. Scoring stops when reached.
ANTHROPIC_MONTHLY_BUDGET_EUR=30.0
# EUR/USD rate used for budget accounting (override on FX moves).
USD_EUR_RATE=0.92

# ---- Telegram (main notification channel) ----
TELEGRAM_BOT_TOKEN=
# One or many chat IDs, comma-separated. Each recipient must /start the bot once.
# Example (you + your partner): TELEGRAM_CHAT_ID=12345678,87654321
TELEGRAM_CHAT_ID=
# Optional: external URL for webhook mode (otherwise polling / disabled)
TELEGRAM_WEBHOOK_URL=

# ---- Discord (OPTIONAL — leave empty to skip) ----
# Set this only if you also want Discord pings. Telegram alone is fine.
DISCORD_WEBHOOK_URL=

# ---- ntfy.sh (OPTIONAL — leave empty to skip) ----
# Free push channel. Pick any unguessable string and subscribe on the ntfy
# mobile app. Example: NTFY_TOPIC=pfh-9f3k2b7v
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# ---- Scoring thresholds (override YAML if set) ----
SCORE_ALERT_THRESHOLD=70
SCORE_URGENT_THRESHOLD=85

# ---- Scrapers ----
PLAYWRIGHT_HEADLESS=true
# Poll cadences (seconds) — jitter applied automatically.
SCRAPE_INTERVAL_LEBONCOIN=90
SCRAPE_INTERVAL_SELOGER=90
SCRAPE_INTERVAL_PAP=300
SCRAPE_INTERVAL_BIENICI=300
SCRAPE_INTERVAL_LOGIC_IMMO=300
# Max consecutive failures before alerting.
SCRAPER_FAIL_THRESHOLD=3

# ---- Proxies (optional, level-2 anti-ban) ----
USE_PROXIES=false
PROXY_PROVIDER=                       # iproyal | webshare | custom
PROXY_URL=                            # e.g. http://user:pass@gate.example:10000
PROXY_ROTATION_SECONDS=600

# ---- Search criteria ----
# Path to the YAML criteria file (default path usually fine)
SEARCH_CRITERIA_PATH=config/search_criteria.yaml

# ---- FastAPI ----
API_HOST=0.0.0.0
API_PORT=8000
ADMIN_TOKEN=change-me-admin-token

# ---- Contact-message flow ----
# Signs Claude-drafted messages with this first name.
USER_FIRST_NAME=Léo
# When true AND a real email is detected on a listing, the drafted contact
# message is emailed automatically via SMTP below (Gmail app-password works).
# Most LBC/SeLoger listings hide the email behind their own form, so this will
# only fire for PAP particuliers, Bien'ici, and a few pros. Otherwise the
# message is pushed to Telegram for you to paste into the site's form.
AUTO_SEND_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=

# ---- Auto-application (DossierFacile) ----
# Rollout: AUTO_APPLY_ENABLED=true first → DRY-RUN ("[TEST]" receipts in Telegram,
# nothing sent). Verify the drafts, THEN AUTO_APPLY_LIVE=true to send for real.
# Email path only (PAP/pros exposing a mail); leboncoin/seloger have no email.
AUTO_APPLY_ENABLED=false
AUTO_APPLY_LIVE=false
AUTO_APPLY_MIN_SCORE=75
AUTO_APPLY_DAILY_CAP=20
USER_DOSSIER_URL=

# ---- Active scraping window (local time = TZ above) ----
# Mon-Sat 08:00-19:00 by default. Outside it, nothing scrapes (saves credits).
SCRAPE_WINDOW_ENABLED=true
SCRAPE_WINDOW_START_HOUR=8
SCRAPE_WINDOW_END_HOUR=19
SCRAPE_WINDOW_LAST_WEEKDAY=5   # Mon=0 .. Sat=5 → Sunday (6) excluded

# ---- Scrapfly credit guard ----
# Pauses DataDome sources + Telegram-alerts if the burn exceeds 1.5x the
# sustainable pace for the billing period. Auto-resumes when it recovers.
SCRAPFLY_GUARD_ENABLED=true
SCRAPFLY_GUARD_RATIO=1.5
